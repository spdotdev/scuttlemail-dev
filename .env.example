# Environment variables consumed by spdotdev/scuttlemail-dev.
#
# This package is a Laravel library, not a standalone app: it has no .env
# of its own. Copy the lines below into the *host application's* .env so the
# package works as soon as it is installed. Every variable already has a safe
# default (see config/scuttlemail-dev.php), so omitting this file entirely will
# NOT break the install; it only lets you override the defaults.

# Host this package answers on. Defaults to "scuttlemail.dev" if unset.
# Set this to a local/staging host (e.g. localhost) when verifying the
# package outside of production.
SCUTTLEMAIL_DOMAIN=scuttlemail.dev
